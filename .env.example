# Copy to .env.local for local use. On Vercel, add the same keys under
# Project → Settings → Environment Variables (then redeploy).

# ---------- Administrator (required on Vercel) ----------
# Created automatically the first time the app runs if no user has this email.
# After that the admin changes their password inside the app; this value is not re-applied.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# ---------- New members ----------
# Temporary password every new user gets (they must change it on first sign-in).
# DEFAULT_USER_PASSWORD=test@impanoent

# ---------- Sessions ----------
# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public address used in email links, e.g. https://projects.impanoent.com
# (optional: defaults to the address the request came in on)
# APP_URL=

# ---------- Email (required in production: sign-in codes & invitations) ----------
# Option A, Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Option B, Resend (https://resend.com): verify your domain there, then:
# RESEND_API_KEY=re_...
#
# Sender shown on emails (must be your Gmail address, or an address on your Resend-verified domain)
# MAIL_FROM=Impano Projects <projects@impanoent.com>

# ---------- Storage (required on Vercel) ----------
# Vercel's filesystem is not persistent, so use Upstash Redis / Vercel KV.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_DB_KEY=impano_projects_db

# Local JSON database location (default: ./data). Back this folder up!
# DATA_DIR=./data
