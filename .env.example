# Copy to .env.local and fill in what you need. Everything is optional for local use.

# Secret used to sign login sessions. If unset, a random secret is generated and stored in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the local JSON database is stored (default: ./data). Back this folder up!
# DATA_DIR=./data

# Optional cloud storage (needed when deploying to Vercel or any serverless host).
# Use a Upstash Redis / Vercel KV database. Use a DIFFERENT key than the website's CMS.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_DB_KEY=impano_projects_db
